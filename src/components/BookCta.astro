---
/**
 * Open & Async promo, ported from ben.balter.com's BookCta (featured variant)
 * and word2md's promo card so the book reads the same everywhere: a navy
 * "book object" with the commit-graph motif, the 3D cover, and the lime→pink
 * accent. Colors are fixed, not theme tokens, so the card matches the book's
 * site in both light and dark mode.
 */
import { Image } from "astro:assets";
import { COMMIT_GRAPH_PATHS } from "../brand";
import { AUTHOR, BOOK_LINK } from "../consts";
import cover from "../assets/img/open-and-async-cover.webp";
---

<a
  href={BOOK_LINK}
  rel="noopener"
  class="book-promo group border-brand-600 dark:border-lime/30 bg-brand-950 focus-visible:outline-lime relative mt-4 block overflow-hidden rounded-xl border px-6 py-8 text-white no-underline shadow-sm transition-all duration-200 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:hover:-translate-y-px"
>
  <svg
    class="pointer-events-none absolute inset-x-0 bottom-0 h-10 w-full opacity-40"
    viewBox="0 0 1200 60"
    fill="none"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
    set:html={COMMIT_GRAPH_PATHS}
  />
  <div class="relative flex flex-col items-center gap-6 sm:flex-row sm:text-left">
    <Image
      src={cover}
      alt="Open & Async book cover"
      width={144}
      height={160}
      widths={[144, 288]}
      sizes="144px"
      loading="lazy"
      decoding="async"
      class="h-auto w-36 shrink-0"
    />
    <div class="text-center sm:text-left">
      <p class="book-promo-muted text-lime mb-1 font-mono text-[0.7rem] tracking-widest uppercase">
        <span aria-hidden="true">&gt;</span> Adapted from the book
      </p>
      <p class="font-serif-display mb-1 text-3xl leading-tight">
        Open <span class="oa-amp">&amp;</span> Async
      </p>
      <p class="book-promo-muted text-sm text-slate-300">By {AUTHOR.name}</p>
      <p class="book-promo-muted mt-1 text-sm text-slate-300">
        A playbook for remote and distributed teams that actually work.
      </p>
      <span
        class="book-promo-cta oa-cta-btn text-brand-950 mt-5 inline-flex items-center gap-1.5 rounded-lg px-5 py-2.5 text-sm font-semibold"
      >
        Get the book
        <span
          aria-hidden="true"
          class="transition-transform motion-safe:group-hover:translate-x-0.5"
          >&rarr;</span
        >
      </span>
    </div>
  </div>
</a>
