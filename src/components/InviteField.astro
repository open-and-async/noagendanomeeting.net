---
interface Props {
  label: string;
  value?: string;
}

const { label, value } = Astro.props;
---

<!-- Label and value stay side by side at every width, like a real invite, so
     the empty fields read as one short list instead of label/"(none)" pairs. -->
<div class="flex gap-2 py-1 text-sm">
  <span class="w-22 shrink-0 text-gray-500 dark:text-gray-400">{label}</span>
  {value ? (
    <span class="min-w-0 text-gray-700 dark:text-gray-300">{value}</span>
  ) : (
    <span class="min-w-0 text-gray-500 italic dark:text-gray-400">(none)</span>
  )}
</div>
