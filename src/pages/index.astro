---
import BaseLayout from "../layouts/BaseLayout.astro";
import Invite from "../components/Invite.astro";
import InviteField from "../components/InviteField.astro";
import CopyCard from "../components/CopyCard.astro";
import BookCta from "../components/BookCta.astro";
import { ArrowRight, CircleCheck, CircleX, Copy, Paperclip, Share } from "@lucide/astro";
import {
  AGENDA_TEMPLATE,
  DECLINE_REPLY,
  EXAMPLE_AGENDA,
  HOME_TITLE,
  REPO_URL,
  SHARE_URL,
  SITE_HOST,
} from "../consts";
import { homeGraph } from "../jsonld";
---

<BaseLayout title={HOME_TITLE} structuredData={homeGraph}>
  <main id="content" class="mx-auto max-w-[640px] px-4 pt-8 pb-6 sm:px-6 sm:pt-12 sm:pb-8">
    <article>
      <h1 class="font-serif-display mb-3 text-3xl leading-[1.1] tracking-tight sm:text-[2.5rem]">
        No Agenda<span class="text-accent">,</span> No Meeting<span class="text-accent">.</span>
      </h1>
      <p class="mb-10 text-lg text-gray-500 dark:text-gray-400">
        Why every meeting invite needs an agenda, and how to add one.
      </p>

      <p
        class="mb-6 text-[1.125rem] leading-[1.5] font-medium text-gray-700 sm:text-xl dark:text-gray-300"
      >
        Imagine getting a calendar invite that just says
        <em
          class="not-italic underline decoration-red-600 underline-offset-[3px] dark:decoration-red-400"
          >"Quick sync"</em
        >
        with zero context&hellip; and having no idea what it's about. We've all gotten one. Most of
        us have sent one, too.
      </p>

      <!-- The whole fix in one line, marked up in the accent "correction pen", so
           it shows on a phone's first screen before the full comparison. -->
      <div class="dark:border-brand-600 mb-2 border-y border-gray-200 py-4">
        <p class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
          <span
            class="text-xs font-semibold tracking-wider text-gray-500 uppercase dark:text-gray-400"
            >Subject</span
          >
          <del class="decoration-accent text-gray-500 decoration-2 dark:text-gray-400"
            ><span class="sr-only">from </span>Quick sync</del
          >
          <!-- Arrow and new subject wrap as one unit, so the arrow never dangles. -->
          <span class="inline-flex items-center gap-2">
            <ArrowRight aria-hidden="true" size={16} class="text-accent shrink-0" />
            <ins class="font-semibold no-underline"
              ><span class="sr-only">to </span>Q3 launch: go/no-go decision</ins
            >
          </span>
        </p>
        <p class="mt-2 text-[0.95rem] text-gray-600 dark:text-gray-400">
          Name the decision, list what you'll cover, and attach the read-ahead&mdash;that's it.
        </p>
      </div>

      <!-- On wide screens the two invites sit side by side, breaking out of the
           text column, since the contrast between them is the page's argument. -->
      <div
        class="lg:relative lg:left-1/2 lg:grid lg:w-[60rem] lg:-translate-x-1/2 lg:grid-cols-2 lg:gap-10"
      >
        <section aria-labelledby="before">
          <h2
            id="before"
            class="mt-10 mb-4 flex items-center gap-2 text-xl font-semibold tracking-tight"
          >
            <CircleX aria-hidden="true" size={22} class="text-red-600 dark:text-red-400" />
            <span>Before: the mystery invite</span>
          </h2>

          <Invite
            variant="bad"
            subject="Quick sync"
            reaction="Am I in trouble? Do I need to prepare? What is this even about? 😰"
          >
            <InviteField label="When" value="Tuesday, 2:00 – 2:30 PM" />
            <InviteField label="Goal" />
            <InviteField label="Agenda" />
            <InviteField label="Read-ahead" />
          </Invite>

          <p class="mb-4 leading-relaxed">
            An invite like this makes everyone on it context-switch <em>twice</em>&mdash;once to
            figure out what it's about, and again in the meeting when they arrive unprepared. A
            meeting without an agenda is like calling a function without documentation&mdash;you
            don't know what inputs to prepare or what outputs to expect.
          </p>
        </section>

        <section aria-labelledby="after">
          <h2
            id="after"
            class="mt-10 mb-4 flex items-center gap-2 text-xl font-semibold tracking-tight"
          >
            <CircleCheck aria-hidden="true" size={22} class="text-green-700 dark:text-green-400" />
            <span>After: same meeting, with an agenda</span>
          </h2>

          <Invite
            variant="good"
            subject="Q3 launch: go/no-go decision"
            reaction="Everyone arrives prepared. The meeting is focused. Better decisions get made. ✨"
          >
            <InviteField label="When" value="Tuesday, 2:00 – 2:30 PM" />
            <InviteField label="Goal" value="Decide whether the Q3 beta ships" />
            <div class="dark:border-brand-600 mt-3 border-t border-gray-100 pt-3">
              <div
                class="mb-1 text-xs font-semibold tracking-wider text-gray-500 uppercase dark:text-gray-400"
              >
                Agenda
              </div>
              <ol class="list-decimal pl-5 text-sm text-gray-700 dark:text-gray-300">
                {EXAMPLE_AGENDA.map((item) => <li class="py-0.5">{item}</li>)}
              </ol>
            </div>
            <div class="mt-2 flex items-center gap-1.5 text-sm">
              <Paperclip aria-hidden="true" size={14} class="text-gray-500 dark:text-gray-400" />
              Read-ahead:
              <span class="font-medium text-gray-700 dark:text-gray-300">Q3 launch status doc</span>
            </div>
          </Invite>

          <p class="mb-4 leading-relaxed">
            Same time slot, same 30 minutes&mdash;but now everyone can prepare, the meeting stays on
            track, and you might even finish early.
          </p>
        </section>
      </div>

      <hr class="dark:border-brand-600 my-10 border-t border-gray-200" />

      <section aria-labelledby="why-this-matters">
        <h2
          id="why-this-matters"
          class="mt-10 mb-4 flex items-center gap-2 text-xl font-semibold tracking-tight"
        >
          Why this matters
        </h2>

        <p class="dark:bg-brand-900 my-6 rounded-lg bg-pink-50 px-5 py-4 text-[0.95rem]">
          Depending on whose survey you read, knowledge workers spend
          <strong class="text-ink dark:text-white">one to two full days a week in meetings</strong
          >&mdash;before they even start the "real work."
        </p>

        <p class="mb-4 leading-relaxed">Every agenda-less meeting carries hidden costs:</p>

        <ul class="arrow-list">
          <li>
            People show up unprepared, so the first 10 minutes is spent catching everyone
            up&mdash;information that could have been shared as a document.
          </li>
          <li>
            Without clear goals, meetings drift. You end 30 minutes later with no decisions and a
            vague promise to "circle back."
          </li>
          <li>
            Context-switching to and from a mystery meeting breaks up the deep focus work that
            creates actual value.
          </li>
          <li>Nobody can tell whether they're needed, so everyone comes "just in case."</li>
        </ul>
      </section>

      <hr class="dark:border-brand-600 my-10 border-t border-gray-200" />

      <section aria-labelledby="if-youre-organizing">
        <h2
          id="if-youre-organizing"
          class="mt-10 mb-4 flex items-center gap-2 text-xl font-semibold tracking-tight"
        >
          If you're organizing
        </h2>

        <p class="text-ink mt-6 mb-4 text-lg leading-snug font-medium dark:text-gray-200">
          Before you schedule a meeting, ask: "Can this start as a document instead?"
        </p>

        <p class="mb-4 leading-relaxed">
          You'd be surprised how often it can. A few minutes of writing often replaces waiting days
          for mutual availability and a 30-minute meeting. If you've done the writing and still need
          to meet, you've just created the agenda.
        </p>

        <ul class="arrow-list">
          <li>
            <strong>Write first, meet second.</strong> Transfer context asynchronously and schedule
            a meeting only if the conversation requires it.
          </li>
          <li>
            <strong>Include clear goals.</strong> What decision needs to be made? What question
            needs to be answered? If you can't put it in a sentence, start with a doc.
          </li>
          <li>
            <strong>Time-box the agenda.</strong> A few minutes per item tells people what matters
            and keeps the meeting from drifting.
          </li>
          <li>
            <strong>Attach a read-ahead.</strong> Let people prepare on their own time instead of
            draining the first 10 minutes on information transfer.
          </li>
        </ul>

        <CopyCard
          heading="Agenda template"
          text={AGENDA_TEMPLATE}
          label="Template"
          preformatted
          variant="invite"
        />
      </section>

      <hr class="dark:border-brand-600 my-10 border-t border-gray-200" />

      <section aria-labelledby="if-you-got-one">
        <h2
          id="if-you-got-one"
          class="mt-10 mb-4 flex items-center gap-2 text-xl font-semibold tracking-tight"
        >
          If you got an invite like this
        </h2>

        <p class="mb-4 leading-relaxed">
          <strong>No agenda? Ask for one, or decline politely.</strong> It's a reasonable request,
          and it often gets you a better meeting.
        </p>

        <CopyCard heading="What to send back" text={DECLINE_REPLY} label="Reply" />
      </section>

      <p class="text-ink mt-10 text-lg leading-snug font-medium dark:text-gray-200">
        Writing scales; meetings don't. A well-written document can reach hundreds of people at
        their convenience without interrupting anyone's flow. A meeting reaches only the people in
        the room, only at that exact moment.
      </p>
    </article>

    <hr class="dark:border-brand-600 mt-10 border-t border-gray-200" />
  </main>

  <footer class="mx-auto max-w-[640px] px-4 pb-8 sm:px-6">
    <div
      class="dark:border-brand-600 dark:bg-brand-900 my-6 rounded-lg border border-dashed border-gray-300 bg-gray-50 px-5 py-4 text-center text-sm text-gray-600 dark:text-gray-400"
    >
      Got an invite without an agenda? Share this page:<br />
      <button
        type="button"
        data-copy-text={SHARE_URL}
        data-share
        class="text-accent-alt hover:border-accent-alt dark:border-brand-600 dark:bg-brand-950 dark:hover:bg-brand-900 mt-2 inline-flex min-h-11 cursor-pointer items-center justify-center gap-1.5 rounded-md border border-gray-300 bg-white px-4 py-2 font-mono text-sm transition-colors hover:bg-pink-50"
      >
        <!-- Touch screens open the share sheet (see canNativeShare), so they get
             a share icon and name; everything else copies. -->
        <span class="sr-only pointer-coarse:hidden">Copy </span
        ><span class="hidden pointer-coarse:inline pointer-coarse:sr-only">Share </span>{SITE_HOST}
        <Copy
          aria-hidden="true"
          size={14}
          class="text-gray-500 pointer-coarse:hidden dark:text-gray-400"
        />
        <Share
          aria-hidden="true"
          size={14}
          class="hidden text-gray-500 pointer-coarse:inline dark:text-gray-400"
        />
      </button>
      <span role="status" class="sr-only" data-copy-status></span>
    </div>

    <BookCta />

    <p class="mt-4 text-center text-xs text-gray-500 dark:text-gray-400">
      Inspired by
      <a
        href="https://nohello.net"
        rel="noopener"
        class="underline hover:text-gray-700 dark:hover:text-gray-300"
        >nohello.net</a
      >
      <span aria-hidden="true">&middot;</span>
      <a
        href={REPO_URL}
        rel="noopener"
        class="underline hover:text-gray-700 dark:hover:text-gray-300"
        >Source on GitHub</a
      >
    </p>
  </footer>

  <script>
    import { initClipboard } from "../clipboard";

    // Module scripts are deferred, so the DOM is already parsed here.
    initClipboard();
  </script></BaseLayout>
